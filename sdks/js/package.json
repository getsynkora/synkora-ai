{
  "name": "synkora",
  "version": "0.1.0",
  "description": "JavaScript/TypeScript SDK for the Synkora AI agent platform",
  "license": "MIT",
  "author": "Synkora <support@synkora.com>",
  "homepage": "https://synkora.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/getsynkora/synkora-ai"
  },
  "bugs": {
    "url": "https://github.com/getsynkora/synkora-ai/issues"
  },
  "keywords": [
    "ai",
    "agents",
    "llm",
    "synkora",
    "chatbot",
    "streaming",
    "sse"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit",
    "lint": "eslint src tests"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
